{
    "$schema": "https://openapi.vercel.sh/vercel.json",

    "cleanUrls": true,

    "trailingSlash": false,

    "rewrites": [
        {
            "source": "/colecao",
            "destination": "/colecao.html"
        },
        {
            "source": "/sobre",
            "destination": "/sobre.html"
        },
        {
            "source": "/contato",
            "destination": "/contato.html"
        },
        {
            "source": "/produto/:slug",
            "destination": "/produto.html?produto=:slug"
        }
    ]
}